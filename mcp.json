{
  "mcpServers": {
    "searxng": {
      "command": "docker",
      "args": [
        "run",
        "--init",
        "--rm",
        "-i",
        "-e",
        "SEARXNG_URL=http://host.docker.internal:8080",
        "-e",
        "SEARXNG_TIMEOUT=10s",
        "-e",
        "SEARCH_DEFAULT_LIMIT=5",
        "-e",
        "FETCH_MAX_CHARS=6000",
        "-e",
        "SEARCH_MAX_BYTES=1048576",
        "-e",
        "WEB_READ_CONCURRENCY=8",
        "-e",
        "MAX_SEARCH_RETRIES=2",
        "-e",
        "LOG_LEVEL=info",
        "searxng-mcp:latest"
      ],
      "env": {}
    }
  }
}